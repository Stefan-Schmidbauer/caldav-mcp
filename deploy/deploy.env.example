# Per-machine settings for deploy.sh.
#
# Copy to deploy.env in the repo root — that file is gitignored, so your server
# details never end up in a commit. Environment variables override it.

# SSH target the remote Docker daemon is reached through. Required.
DEPLOY_HOST=admin@your-server.example.net

# Docker context deploy.sh uses, and creates on first run if it does not exist.
# Shared by every service deployed to the same host; default: the host from
# DEPLOY_HOST without user and port (your-server.example.net).
#DOCKER_CTX=your-server

# Compose file on the server that holds the service definition.
#REMOTE_COMPOSE=/opt/docker/docker-compose.yml

# Health endpoint, resolved on the server (the container publishes on localhost).
#HEALTH_URL=http://127.0.0.1:9153/healthz
