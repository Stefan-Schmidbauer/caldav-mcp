# Secrets and account settings for the CalDAV MCP server.
#
# Lives on the server next to the compose file, as `.env.caldav-mcp`, referenced
# from the service's `env_file:`. Never committed — the deploy never copies it,
# so the secrets stay on the server. Deployment wiring (transport, path,
# timezone, allowed hosts) is not in here but in the compose snippet.
#
# Suggested ownership: root:docker, mode 640, so the admin user can read it
# without sudo.
#
# Compose interprets this file: put a value that contains $, #, spaces or
# quotes in single quotes — PASSWORD='p$ss#word'.

# CalDAV server and account (e.g. Nextcloud, mailbox.org, Radicale).
# Use an app password where the server offers one.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# The calendar new events go to when create_event names none — a `url` from the
# list_calendars tool. Optional: reading covers every calendar the server
# offers, and an account with a single calendar needs no default.
CALDAV_CALENDAR_URL=

# The only calendars the server offers, comma-separated: each a `url` from
# list_calendars or a calendar's name. Empty: every calendar of the account.
# A calendar left out can be neither read nor changed by a client.
CALDAV_CALENDARS=

# Clients must send: Authorization: Bearer <MCP_AUTH_TOKEN>
# Required — the server exits before binding a port if it is empty, because
# reaching the endpoint means reaching the calendars.
# (MCP_ALLOW_UNAUTHENTICATED=1 opts out, for a deployment that authenticates
# further out. It does not replace the network boundary.)
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
